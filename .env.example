# 청춘 맛 드림 — 환경변수 예시. 실제 값은 .env.local(로컬) 에만 넣으세요.
# 두 값 모두 브라우저에 공개되는 값입니다(RLS 로 보호). 둘 다 비어 있으면 / 와 /admin 은 '연결 준비 중' 화면을 보여주고,
# /demo, /demo/admin 데모 화면만 동작합니다.

# Supabase 대시보드 > Project Settings > API (또는 Connect) 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# 'Publishable key' (sb_publishable_...) 권장. 구형 프로젝트는 NEXT_PUBLIC_SUPABASE_ANON_KEY 에 anon 키를 넣어도 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role / secret 키는 이 앱에 필요하지 않습니다. 절대 NEXT_PUBLIC_ 변수나 저장소에 넣지 마세요.
